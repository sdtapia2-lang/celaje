---
import Base from '../../layouts/Base.astro';
import { Image } from 'astro:assets';
import { ARTICULOS_BLOG } from '../../config/contenido';

export function getStaticPaths() {
  return ARTICULOS_BLOG.map((a) => ({ params: { slug: a.slug }, props: { articulo: a } }));
}

const { articulo } = Astro.props;
const formateador = new Intl.DateTimeFormat('es-CL', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base titulo={articulo.titulo} descripcion={articulo.resumen}>
  <section class="seccion seccion--compacta">
    <div class="contenedor medida-lectura">
      <p class="rastro"><a href="/">Inicio</a> / <a href="/blog">Blog</a> / {articulo.titulo}</p>
      <p class="etiqueta">{formateador.format(new Date(`${articulo.fecha}T00:00:00`))} · {articulo.tiempoLectura}</p>
      <h1 class="titulo-seccion">{articulo.titulo}</h1>
      <p class="bajada">{articulo.resumen}</p>

      <figure class="blog-articulo__imagen">
        <Image src={articulo.imagen} alt={articulo.imagenAlt} widths={[480, 800, 1200]} sizes="(min-width: 860px) 62ch, 90vw" loading="eager" />
      </figure>

      <div class="blog-articulo__cuerpo">
        {articulo.cuerpo.map((parrafo) => <p>{parrafo}</p>)}
      </div>

      <p class="blog-articulo__volver"><a href="/blog" class="btn btn--texto">Volver al blog</a></p>
    </div>
  </section>
</Base>
