---
/**
 * Dibuja un patrón generado como superficie teselada.
 *
 * Usa `mask-image` y no `background-image` a propósito: un SVG cargado como
 * imagen de fondo no hereda `currentColor`, así que habría que generar una
 * copia del archivo por cada color. Como máscara, el SVG aporta solo la forma
 * y el color sale de un token, de modo que un único archivo sirve para todas
 * las variantes.
 *
 * `sombra` inclina y desenfoca la trama para leerse como la sombra que el
 * panel proyecta, en vez del panel mismo.
 */
import { patronPorSlug } from '../config/contenido';

interface Props {
  patron: string;
  /** Ancho del módulo en px. Equivale al `moduloMm` real del patrón. */
  escala?: number;
  color?: string;
  opacidad?: number;
  sombra?: boolean;
  /**
   * Cubre al ancestro posicionado. Va por defecto y se resuelve DENTRO del
   * componente a propósito: los estilos con alcance de Astro no cruzan la
   * frontera del componente, así que una clase pasada desde la página llega
   * sin su atributo de alcance y sus reglas nunca aplican. Posicionar desde
   * afuera deja el div en altura cero y el patrón invisible.
   */
  relleno?: boolean;
  class?: string;
}

const {
  patron,
  escala = 180,
  color = 'var(--color-tinta)',
  opacidad = 1,
  sombra = false,
  relleno = true,
  class: clase,
} = Astro.props;

const datos = patronPorSlug(patron);
if (!datos) throw new Error(`Patrón desconocido: "${patron}"`);

const alto = escala / datos.relacionCelda;
---

<div
  class:list={['patron', relleno && 'patron--relleno', sombra && 'patron--sombra', clase]}
  style={`--url:url('/patrones/${patron}.svg');--w:${escala}px;--h:${alto.toFixed(2)}px;--tinte:${color};--op:${opacidad}`}
  aria-hidden="true"
>
</div>

<style>
  .patron {
    background-color: var(--tinte);
    opacity: var(--op);
    mask-image: var(--url);
    mask-repeat: repeat;
    mask-size: var(--w) var(--h);
    -webkit-mask-image: var(--url);
    -webkit-mask-repeat: repeat;
    -webkit-mask-size: var(--w) var(--h);
    pointer-events: none;
  }

  .patron--relleno {
    position: absolute;
    inset: 0;
  }

  /* La sombra de un panel calado nunca cae a escuadra: se alarga y se inclina
     según la altura del sol, y pierde definición con la distancia. */
  .patron--sombra {
    transform: skewY(-8deg) skewX(-3deg) scale(1.25);
    transform-origin: top left;
    filter: blur(1.5px);
  }
</style>
